.venv/
node_modules/
.next/
.env*
!.env.example
__pycache__/
.pytest_cache/
*.egg-info/
tsconfig.tsbuildinfo

# 派生データ。data/raw から再生成できる
data/interim/
data/processed/

# 標高タイルのローカルキャッシュ(再配布しない — 構想書 §2.4)
data/raw/gsi-cache/

artifacts/
*.pt
*.pth

# seed を変えた再現性確認の出力(手元専用・学習に時間がかかるので同梱しない)
data/derived/*seed*

# 書き出したブラウザ用モデルは明示的に残す
!public/models/*.onnx

# Next.js の静的書き出し(output: 'export')の出力。Vercel は自分で next build して作るので入力ではない。
out/
.vercel
